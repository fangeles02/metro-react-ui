{
  "name": "@metro-react-ui/core",
  "version": "0.1.1",
  "description": "Web port of the Windows Phone Toolkit — Metro/Modern UI React components",
  "keywords": [
    "metro",
    "metro-ui",
    "windows-phone",
    "windows-phone-toolkit",
    "modern-ui",
    "react",
    "ui",
    "components",
    "component-library"
  ],
  "author": "Fernando Angeles Jr",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/fangeles02/metro-react-ui.git"
  },
  "homepage": "https://metro-ui-demo.fajstudio.me",
  "bugs": {
    "url": "https://github.com/fangeles02/metro-react-ui/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/metro-ui.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite build --watch",
    "build": "tsc -p tsconfig.build.json && vite build",
    "pack": "npm run build && npm pack"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "^7.59.1",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "typescript": "^5.3.0",
    "vite": "^6.4.3",
    "vite-plugin-dts": "^5.1.0"
  }
}
